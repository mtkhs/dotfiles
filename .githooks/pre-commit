#!/bin/bash
# pre-commit - syntax-check staged files before they enter a commit.
#
# Enabled per clone by install.bash / install.ps1:
#   git config --local core.hooksPath .githooks
#
# Staged content is piped to each checker (git show :path), not the working
# tree, so a commit never records a file that fails to parse. A checker that is
# unavailable on the platform is reported as skipped rather than passing
# silently.

set -uo pipefail

status=0

# --- Reporting ------------------------------------------------------------

report_failure() {
    local path="$1"
    local details="$2"

    echo "  [FAIL] $path"
    if [ -n "$details" ]; then
        printf '%s\n' "$details" | sed 's/^/         /'
    fi

    status=1
}

report_skip() {
    local path="$1"
    local reason="$2"

    echo "  [SKIP] $path ($reason)"
}

# --- Locating the checkers ------------------------------------------------

# pwsh is absent from PATH under WSL; fall back to the Windows install so that
# .ps1 edits made from Linux are still checked.
find_pwsh() {
    local found
    found="$(command -v pwsh 2>/dev/null)"
    if [ -n "$found" ]; then
        echo "$found"
        return 0
    fi

    local candidate
    for candidate in /mnt/c/Program\ Files/PowerShell/*/pwsh.exe; do
        if [ -x "$candidate" ]; then
            echo "$candidate"
            return 0
        fi
    done

    return 1
}

# Python is named python3 on Unix and python on Windows.
find_python() {
    local name
    local found

    for name in python3 python; do
        found="$(command -v "$name" 2>/dev/null)"
        if [ -n "$found" ]; then
            echo "$found"
            return 0
        fi
    done

    return 1
}

PWSH="$(find_pwsh || true)"
PYTHON="$(find_python || true)"

# --- Parser scripts -------------------------------------------------------

PWSH_PARSE='
if ($PSStyle) { $PSStyle.OutputRendering = "PlainText" }
$source = [Console]::In.ReadToEnd()
$errors = $null
[System.Management.Automation.Language.Parser]::ParseInput($source, [ref]$null, [ref]$errors) | Out-Null
if ($errors) {
    $errors | ForEach-Object { $_.ToString() }
    exit 1
}'

PYTHON_PARSE='
import json
import sys

try:
    json.load(sys.stdin)
except json.JSONDecodeError as error:
    sys.exit(str(error))'

# --- Checking -------------------------------------------------------------

# Feed one file's staged content to a checker on stdin.
check() {
    local path="$1"
    shift

    local output
    if output="$(git show ":$path" | "$@" 2>&1)"; then
        return 0
    fi

    report_failure "$path" "$(printf '%s' "$output" | tr -d '\r')"
    return 1
}

check_bash() {
    local path="$1"

    check "$path" bash -n
}

check_zsh() {
    local path="$1"

    if ! command -v zsh >/dev/null 2>&1; then
        report_skip "$path" "zsh not found"
        return 0
    fi

    check "$path" zsh -n
}

check_powershell() {
    local path="$1"

    if [ -z "$PWSH" ]; then
        report_skip "$path" "pwsh not found"
        return 0
    fi

    check "$path" "$PWSH" -NoProfile -Command "$PWSH_PARSE"
}

check_json() {
    local path="$1"

    if [ -z "$PYTHON" ]; then
        report_skip "$path" "python not found"
        return 0
    fi

    check "$path" "$PYTHON" -c "$PYTHON_PARSE"
}

# --- Main -----------------------------------------------------------------

while IFS= read -r path; do
    case "$path" in
        *.bash|.githooks/*)
            check_bash "$path"
            ;;
        *.zsh|.zsh/.z*|.zshenv)
            check_zsh "$path"
            ;;
        *.ps1)
            check_powershell "$path"
            ;;
        *.json)
            check_json "$path"
            ;;
    esac
done < <(git diff --cached --name-only --diff-filter=ACM)

if [ "$status" -ne 0 ]; then
    echo ""
    echo "pre-commit: syntax check failed. Fix the files above, or bypass with --no-verify."
fi

exit "$status"
